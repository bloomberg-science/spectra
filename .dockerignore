# Large directories not needed in Docker image
testsuite/binaries/
testsuite/bde/
testsuite/bde-tools/
testsuite/gcc/
testsuite/gcc-coverage/
testsuite/redhat/
testsuite/apache-httpd/

testsuite/apache/
